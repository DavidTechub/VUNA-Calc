{
  "name": "vuna-calc1",
  "version": "2.0.0",
  "description": "VUNA Calculator with CI/CD Pipeline",
  "scripts": {
    "test": "jest --coverage",
    "test:ci": "jest --ci --coverage --coverageReporters=json-summary --coverageReporters=text",
    "lint": "eslint .",
    "build": "node scripts/build.mjs"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 0,
        "functions": 0,
        "lines": 0,
        "statements": 0
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  }
}